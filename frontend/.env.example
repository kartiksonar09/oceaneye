# Ocean Eye — Frontend Environment Variables
# Copy this file to `.env` and fill in your values.

# ─── API Base URL ─────────────────────────────────────────────────────────────
# When using Vite dev proxy, /api → http://127.0.0.1:8000
VITE_API_BASE_URL=/api

# ─── Mock Mode ────────────────────────────────────────────────────────────────
# Set to 'false' to use the live backend API (requires running server)
VITE_USE_MOCK=true

# ─── Vessel Photo Provider ───────────────────────────────────────────────────
# See src/services/vesselPhotoService.ts to switch ACTIVE_PROVIDER.
#
# Option A: VesselFinder API
# Register at: https://api.vesselfinder.com/
VITE_VESSELFINDER_API_KEY=

# Option B: MarineTraffic Official API  (charged per call)
# Register at: https://www.marinetraffic.com/en/ais-api-services/
# DO NOT hotlink or scrape MarineTraffic website assets.
VITE_MARINETRAFFIC_API_KEY=

# ─── Auth (Optional) ─────────────────────────────────────────────────────────
VITE_AUTH_HEADER_NAME=Authorization
VITE_AUTH_TOKEN=
